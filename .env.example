# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for /api/collect to store pageviews securely without requiring user auth)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL (Used for generating snippet scripts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
